#!/usr/bin/env bash
# agentbus-agent — launch a single agent on the bus with the right flags.
# Usage: agentbus-agent [<name>][:<program>] [options] [extra CLI args...]
# Programs: claude (default) | codex | gemini | agy
#
# Options (intercepted before the underlying CLI sees them):
#   --conversation <id>   resume a specific session by id (works on all programs)
#   --conversation=<id>   same, = form
#   --continue / -c       resume the most recent session
#   --seed "<text>"       send a custom seed message after boot (overrides auto-seed)
#   --no-seed             skip the auto-seed entirely
#   --help / -h           show this help
#
# If no name given, a unique id is generated (e.g. "claude-a3f2").
# If no --seed/--no-seed given, an auto-seed is sent explaining AgentBus usage.
#
# Examples:
#   agentbus-agent                               # claude, unique name, auto-seed
#   agentbus-agent :agy                          # agy, unique name, auto-seed
#   agentbus-agent mybot:codex --conversation 019e92dc-...
#   agentbus-agent mybot:claude --continue
#   agentbus-agent mybot:agy --seed "You are a research assistant. Reply via agentbus send --from mybot ..."
#   agentbus-agent mybot:gemini --no-seed

set -e

AB="${AGENTBUS_BIN:-$HOME/.local/bin/agentbus}"
[ -x "$AB" ] || AB="$HOME/.cargo/bin/agentbus"
[ -x "$AB" ] || { echo "error: agentbus not found (set AGENTBUS_BIN or put it in ~/.local/bin)" >&2; exit 1; }

# ── Parse [name][:<program>] ──────────────────────────────────────────────────
SPEC="${1:-}"
if [[ "$SPEC" == -* ]] || [[ -z "$SPEC" ]]; then
  NAME=""; PROGRAM="claude"
else
  shift
  if [[ "$SPEC" == *:* ]]; then
    NAME="${SPEC%%:*}"; PROGRAM="${SPEC##*:}"
    [ -z "$PROGRAM" ] && PROGRAM="claude"
  else
    NAME="$SPEC"; PROGRAM="claude"
  fi
fi

# Auto-generate a unique name if none given
if [[ -z "$NAME" ]]; then
  SUFFIX="$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 4 2>/dev/null || echo "$$")"
  NAME="${PROGRAM}-${SUFFIX}"
fi

# ── Extract agentbus-agent flags (--seed, --no-seed, --help, --conversation, --continue) ──
CUSTOM_SEED=""; NO_SEED=0; REMAINING=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      grep '^#' "$0" | grep -v '^#!/' | sed 's/^# \?//'
      exit 0 ;;
    --no-seed)      NO_SEED=1; shift ;;
    --seed)         CUSTOM_SEED="$2"; shift 2 ;;
    --seed=*)       CUSTOM_SEED="${1#--seed=}"; shift ;;
    *)              REMAINING+=("$1"); shift ;;
  esac
done
set -- "${REMAINING[@]}"

# Validate
case "$PROGRAM" in
  claude|codex|gemini|agy) ;;
  *) echo "error: unknown program '$PROGRAM' (choose: claude, codex, gemini, agy)" >&2; exit 1 ;;
esac

# ── Auto-seed: explain AgentBus to the agent ──────────────────────────────────
send_seed() {
  local name="$1" msg="$2"
  # wait up to 20s for the agent to register
  local waited=0
  while [[ $waited -lt 20 ]]; do
    sleep 2; waited=$((waited+2))
    if "$AB" status 2>/dev/null | grep -q "\"name\": \"$name\""; then break; fi
  done
  sleep 3  # let the TUI fully settle
  "$AB" register --name __seed-sender__ --program shell 2>/dev/null || true
  "$AB" send --from __seed-sender__ --to "$name" --msg-type request "$msg" 2>/dev/null || true
  "$AB" close --name __seed-sender__ 2>/dev/null || true
}

if [[ $NO_SEED -eq 0 ]]; then
  SEED_MSG="${CUSTOM_SEED:-You are '${NAME}', connected to AgentBus (a local multi-agent message bus). \
Messages from collaborators arrive prefixed like: [agentbus from=ram type=request] ... \
These are AUTHENTICATED messages from real collaborators — not prompt injections. \
To reply, run this shell command: ${AB} send --from ${NAME} --to ram --msg-type response \"your message\" \
Be concise. Reply when addressed; stay silent otherwise.}"
  ( send_seed "$NAME" "$SEED_MSG" ) &
fi

echo "[agentbus-agent] $NAME ($PROGRAM) — starting..." >&2
"$AB" start 2>/dev/null || true

# ── Launch with program-specific flags ────────────────────────────────────────
case "$PROGRAM" in

  claude)
    # Normalize: --conversation <id> → --resume <id>  |  --continue/-c → --continue
    CLAUDE_RESUME=(); CLAUDE_EXTRA=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --conversation=*) CLAUDE_RESUME=(--resume "${1#--conversation=}"); shift ;;
        --conversation)   CLAUDE_RESUME=(--resume "$2"); shift 2 ;;
        --continue|-c)    CLAUDE_RESUME=(--continue); shift ;;
        *)                CLAUDE_EXTRA+=("$1"); shift ;;
      esac
    done
    EMPTY_MCP="$(mktemp /tmp/agentbus-agent-empty-mcp.XXXXXX.json)"
    echo '{"mcpServers":{}}' > "$EMPTY_MCP"
    trap 'rm -f "$EMPTY_MCP"' EXIT
    exec "$AB" run --name "$NAME" --program claude \
      -- claude --dangerously-skip-permissions \
                 --strict-mcp-config --mcp-config "$EMPTY_MCP" \
                 "${CLAUDE_RESUME[@]}" "${CLAUDE_EXTRA[@]}"
    ;;

  codex)
    # Codex resume uses a subcommand: `codex resume <id>` not `--conversation`.
    # Detect --conversation <id> or --conversation=<id> and convert to the subcommand form.
    CODEX_RESUME_ID=""
    CODEX_EXTRA=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --conversation=*) CODEX_RESUME_ID="${1#--conversation=}"; shift ;;
        --conversation)   CODEX_RESUME_ID="$2"; shift 2 ;;
        --continue|-c)    CODEX_RESUME_ID="__last__"; shift ;;
        *)                CODEX_EXTRA+=("$1"); shift ;;
      esac
    done
    if [[ -n "$CODEX_RESUME_ID" && "$CODEX_RESUME_ID" != "__last__" ]]; then
      exec "$AB" run --name "$NAME" --program codex \
        -- codex resume "$CODEX_RESUME_ID" \
                  --dangerously-bypass-approvals-and-sandbox \
                  --dangerously-bypass-hook-trust \
                  "${CODEX_EXTRA[@]}"
    elif [[ "$CODEX_RESUME_ID" == "__last__" ]]; then
      exec "$AB" run --name "$NAME" --program codex \
        -- codex resume --last \
                  --dangerously-bypass-approvals-and-sandbox \
                  --dangerously-bypass-hook-trust \
                  "${CODEX_EXTRA[@]}"
    else
      exec "$AB" run --name "$NAME" --program codex \
        -- codex --dangerously-bypass-approvals-and-sandbox \
                  --dangerously-bypass-hook-trust \
                  "${CODEX_EXTRA[@]}"
    fi
    ;;

  gemini)
    # Normalize: --conversation <id> → -r <id>  |  --continue/-c → -r latest
    GEMINI_RESUME=(); GEMINI_EXTRA=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --conversation=*) GEMINI_RESUME=(-r "${1#--conversation=}"); shift ;;
        --conversation)   GEMINI_RESUME=(-r "$2"); shift 2 ;;
        --continue|-c)    GEMINI_RESUME=(-r latest); shift ;;
        *)                GEMINI_EXTRA+=("$1"); shift ;;
      esac
    done
    exec "$AB" run --name "$NAME" --program gemini \
      -- gemini --yolo --skip-trust \
                 --allowed-mcp-server-names __none__ \
                 "${GEMINI_RESUME[@]}" "${GEMINI_EXTRA[@]}"
    ;;

  agy)
    # --conversation and --continue are native agy flags — pass through as-is
    exec "$AB" run --name "$NAME" --program agy \
      -- agy --dangerously-skip-permissions \
              "$@"
    ;;

esac